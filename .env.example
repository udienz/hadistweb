# All variables are optional. They are deliberately NOT prefixed with NEXT_PUBLIC_:
# they are read on the server at request time, so they can be changed with
# `docker run -e HADITH_FAWAZ_URL=...` without rebuilding the image.

# Base URL of fawazahmed0/hadith-api (the folder that holds editions/ and info.min.json).
# Empty = https://raw.githubusercontent.com/fawazahmed0/hadith-api/1
# jsDelivr is not used: it refuses this package (over its 150 MB limit).
# In production, point it to our own mirror: an HTTP URL, or a local directory such as
# /data/hadith-api, so no HTTP request is made at all.
HADITH_FAWAZ_URL=
